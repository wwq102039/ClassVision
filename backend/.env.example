# 复制为 backend/.env 后按需修改；backend/.env 已被 .gitignore 排除，不会入库。
# 所有变量都有内置默认值，不配置也能跑起来（零配置启动）。

# ---------- 数据库 ----------
# 默认：backend/classvision.db（SQLite）
CV_DB_URL=sqlite:///classvision.db

# ---------- 路径（默认相对 backend/ 与项目根目录）----------
# CV_MODEL_DIR=../model
# CV_STORAGE_DIR=./storage

# ---------- 人脸检测器 ----------
# auto | onnx | pt    （auto：优先 ONNX，缺失时回退 ultralytics PT）
CV_DETECTOR_BACKEND=auto
CV_DETECTOR_MODEL_ONNX=yolov8n_face.onnx
CV_DETECTOR_MODEL_PT=yolov8n_face.pt
CV_DETECT_CONF=0.25
CV_DETECT_IOU=0.45
CV_DETECT_IMG_SIZE=640

# ---------- 人脸特征提取 ----------
# auto | insightface | face_recognition | fallback
# auto：按 insightface → face_recognition → 内置降级 依次选择可用实现
CV_EMBEDDER_BACKEND=auto

# ---------- 身份判定阈值（余弦相似度）----------
CV_MATCH_THRESHOLD=0.5

# ---------- 考勤规则 ----------
CV_LATE_GRACE_MINUTES=10
CV_CLASS_START_HOUR=8
CV_CLASS_START_MINUTE=0

# ---------- 安全 ----------
# 生产环境必须替换为随机长字符串
CV_TOKEN_SECRET=change-me-to-a-random-64-char-string
CV_TOKEN_EXPIRE_MINUTES=1440

# ---------- 初始账号 ----------
CV_ADMIN_USERNAME=admin
CV_ADMIN_PASSWORD=change-me-before-deploy
CV_ADMIN_NAME=管理员
CV_STUDENT_DEFAULT_PASSWORD=change-me-before-deploy

# ---------- 本地 MCP 工具服务（AI 助手的只读数据查询）----------
CV_MCP_ENABLED=false
CV_MCP_HOST=127.0.0.1
CV_MCP_PORT=8765
# CV_MCP_OFFICIAL_ENDPOINT=wss://example.com/mcp

# ---------- 小智语音助手桥接 ----------
CV_XIAOZHI_ENABLED=false
# CV_XIAOZHI_WEBSOCKET_URL=wss://api.tenclass.net/xiaozhi/v1/
# CV_XIAOZHI_OTA_URL=https://api.tenclass.net/xiaozhi/ota/
# CV_XIAOZHI_LOCAL_WEBSOCKET_URL=
# CV_XIAOZHI_LOCAL_OTA_URL=
